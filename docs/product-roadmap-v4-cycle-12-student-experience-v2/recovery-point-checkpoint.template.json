{
  "decision": "AUTHORIZED_CONSISTENT_BACKUP_WINDOW",
  "production_readiness": "NO_GO",
  "freeze": {
    "started_at_utc": "<ISO-8601 UTC>",
    "ended_at_utc": "<ISO-8601 UTC>",
    "application_writes_frozen": true,
    "storage_writes_frozen": true,
    "background_jobs_paused": true
  },
  "database": {
    "snapshot_started_at_utc": "<ISO-8601 UTC>",
    "snapshot_completed_at_utc": "<ISO-8601 UTC>",
    "artifacts": [
      {
        "path": "<absolute path outside Git>/roles.sql",
        "sha256": "<lowercase SHA-256>",
        "snapshot_bound": false,
        "snapshot_fingerprint": null
      },
      {
        "path": "<absolute path outside Git>/schema.sql",
        "sha256": "<lowercase SHA-256>",
        "snapshot_bound": true,
        "snapshot_fingerprint": "<SHA-256 of the exported snapshot identifier>"
      },
      {
        "path": "<absolute path outside Git>/data.sql",
        "sha256": "<lowercase SHA-256>",
        "snapshot_bound": true,
        "snapshot_fingerprint": "<same snapshot fingerprint>"
      },
      {
        "path": "<absolute path outside Git>/history_schema.sql",
        "sha256": "<lowercase SHA-256>",
        "snapshot_bound": true,
        "snapshot_fingerprint": "<same snapshot fingerprint>"
      },
      {
        "path": "<absolute path outside Git>/history_data.sql",
        "sha256": "<lowercase SHA-256>",
        "snapshot_bound": true,
        "snapshot_fingerprint": "<same snapshot fingerprint>"
      }
    ]
  },
  "storage": {
    "inventory_captured_at_utc": "<ISO-8601 UTC>",
    "export_started_at_utc": "<ISO-8601 UTC>",
    "export_completed_at_utc": "<ISO-8601 UTC>",
    "reconciliation_report_path": "<absolute path outside Git>/storage-reconciliation-report.json"
  }
}
