{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOEDecisionRequestV1",
  "contractVersion": "1.0.0-rc.1",
  "type": "object",
  "required": ["contractVersion", "requestId", "idempotencyKey", "actor", "student", "options"],
  "properties": {
    "contractVersion": { "const": "1.0.0-rc.1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 200 },
    "actor": {
      "type": "object",
      "required": ["actorId", "role"],
      "properties": {
        "actorId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "enum": ["PROFESSIONAL", "ADMIN", "SYSTEM", "STUDENT_READ_ONLY"] },
        "organizationId": { "type": ["string", "null"], "maxLength": 100 }
      }
    },
    "student": {
      "type": "object",
      "required": ["studentId", "goal", "experienceLevel", "availableDaysPerWeek", "availableMinutesPerSession", "equipmentProfile", "constraints", "recovery"],
      "properties": {
        "studentId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "availableDaysPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
        "availableMinutesPerSession": { "type": "integer", "minimum": 15, "maximum": 240 },
        "availableEquipment": { "type": "array", "maxItems": 100 },
        "constraints": { "type": "array", "maxItems": 50 }
      }
    },
    "options": {
      "type": "object",
      "required": ["maxAlternatives", "includeDecisionTrace", "requireHumanReviewBeforeDelivery", "activeReleases"]
    }
  },
  "additionalProperties": false
}
