{
  "name": "consultoriafitness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "qa:finance-modals": "node --env-file=.env.qa.local scripts/validate-finance-modals-cdp.mjs",
    "qa:renovacao-mobile": "node --env-file=.env.qa.local scripts/validate-renovacao-plano-mobile-cdp.mjs",
    "qa:dashboard-mobile": "node --env-file=.env.qa.local scripts/validate-dashboard-mobile-cdp.mjs",
    "qa:alunos-mobile": "node --env-file=.env.qa.local scripts/validate-alunos-mobile-cdp.mjs",
    "qa:aluno-form-mobile": "node --env-file=.env.qa.local scripts/validate-aluno-form-mobile-cdp.mjs",
    "qa:aluno-details-mobile": "node --env-file=.env.qa.local scripts/validate-aluno-details-mobile-cdp.mjs",
    "qa:aluno-actions-mobile": "node --env-file=.env.qa.local scripts/validate-aluno-actions-mobile-cdp.mjs",
    "qa:alunos-final": "node --env-file=.env.qa.local scripts/validate-alunos-final-cdp.mjs",
    "qa:alunos-module": "node --env-file=.env.qa.local scripts/validate-alunos-module-cdp.mjs",
    "qa:treinos-mobile": "node --env-file=.env.qa.local scripts/validate-treinos-mobile-cdp.mjs",
    "qa:treino-editor-mobile": "node --env-file=.env.qa.local scripts/validate-treino-editor-mobile-cdp.mjs",
    "qa:treino-templates-mobile": "node --env-file=.env.qa.local scripts/validate-treino-templates-mobile-cdp.mjs",
    "qa:workout-templates-data": "node scripts/validate-workout-templates-data.mjs",
    "qa:workout-template-sanitization": "node scripts/validate-workout-template-sanitization.mjs",
    "qa:cleanup-workout-templates": "node --env-file=.env --env-file=.env.local --env-file=.env.qa.local scripts/cleanup-qa-workout-templates.mjs",
    "qa:treino-custom-templates": "node --env-file=.env --env-file=.env.local --env-file=.env.qa.local scripts/validate-treino-custom-templates-cdp.mjs",
    "qa:treino-editor-module": "node --env-file=.env --env-file=.env.local --env-file=.env.qa.local scripts/validate-treino-editor-module-cdp.mjs",
    "qa:treino-editor-final": "node --env-file=.env --env-file=.env.local --env-file=.env.qa.local scripts/validate-treino-editor-final-cdp.mjs",
    "qa:treino-exercises-mobile": "node --env-file=.env.qa.local scripts/validate-treino-exercises-mobile-cdp.mjs",
    "qa:apl": "node scripts/apl/audit.mjs",
    "qa:apl:sprint01": "node scripts/apl/audit.mjs --sprint=1",
    "qa:apl:sprint02": "node scripts/apl/audit.mjs --sprint=2",
    "qa:apl:all": "node scripts/apl/audit.mjs --all",
    "qa:apl:rules": "node scripts/apl/audit.mjs --list-rules",
    "qa:apl:contract": "node scripts/apl/rules/rule-contract.test.mjs",
    "qa:apl:test": "node scripts/apl/tests/rules.test.mjs && node scripts/apl/tests/parser-context.test.mjs && node scripts/apl/tests/sections-context.test.mjs && node scripts/apl/tests/prescriptions-context.test.mjs",
    "qa:apl:test:parser": "node scripts/apl/tests/parser-context.test.mjs",
    "qa:apl:test:sections": "node scripts/apl/tests/sections-context.test.mjs",
    "qa:apl:test:prescriptions": "node scripts/apl/tests/prescriptions-context.test.mjs",
    "qa:apl:baseline": "node scripts/apl/audit.mjs --all --report-format=both",
    "qa:apl:compare": "node scripts/apl/audit.mjs --all --report-format=both",
    "aoe:test": "node --test tests/aoe/*.test.js tests/aoe/catalog/*.test.js",
    "aoe:test:unit": "node --test tests/aoe/aoe-core.test.js",
    "aoe:test:golden": "node --test tests/aoe/golden-scenarios.test.js && node scripts/aoe/validate-golden-scenarios.js",
    "aoe:decision": "node scripts/aoe/cli.js",
    "aoe:validate": "node scripts/aoe/validate-golden-scenarios.js && node scripts/aoe/catalog-cli.js --validate && node scripts/aoe/validate-hardening.js",
    "aoe:rules": "node scripts/aoe/cli.js --list-rules",
    "aoe:catalog": "node scripts/aoe/catalog-cli.js",
    "aoe:catalog:validate": "node scripts/aoe/catalog-cli.js --validate",
    "aoe:catalog:report": "node scripts/aoe/catalog-cli.js --validate --report=both",
    "aoe:catalog:diff": "node scripts/aoe/catalog-cli.js --diff-fixture",
    "aoe:test:catalog": "node --test tests/aoe/catalog/*.test.js",
    "aoe:reasons": "node scripts/aoe/list-reasons.js",
    "aoe:test:explainability": "node --test tests/aoe/explainability.test.js",
    "aoe:test:risk": "node --test tests/aoe/risk.test.js",
    "aoe:test:review": "node --test tests/aoe/review.test.js",
    "aoe:test:adversarial": "node --test tests/aoe/adversarial.test.js",
    "aoe:adversarial": "node scripts/aoe/run-adversarial.js",
    "aoe:validate:hardening": "node scripts/aoe/validate-hardening.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
